{
  "manifest_version": 3,
  "name": "Linear Bug Quick Capture",
  "version": "0.1.0",
  "description": "Capture a region of the page and file it as a Linear bug.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "112",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.linear.app/*",
    "https://uploads.linear.app/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture a Linear bug",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "content/app.js",
        "content/modal.js",
        "content/region-select.js",
        "lib/crop.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
